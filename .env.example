# Leave NEXT_PUBLIC_DATA_SOURCE unset (or "local") to use the bundled demo dataset.
# Set it to "supabase" and fill in the two values below to read from Postgres.
NEXT_PUBLIC_DATA_SOURCE=local
NEXT_PUBLIC_SUPABASE_URL=https://kkkkdwficvcbjhcbvlpc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Ig7G6G0a5eq1BfCG2qSsdA_EiXuLgNH

# Optional — enables AI document extraction on /clearance/new.
# Without it the intake screen falls back to the built-in label parser,
# which reads text-layer PDFs only (no scans or photos).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
